# ---------------------------------------------
# RS Travel monorepo: root .gitignore
# Applies to all apps/ and packages/
# ---------------------------------------------

# dependencies
node_modules/
.pnp
.pnp.*
.pnpm-store/

# build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# turborepo (added later)
.turbo/

# testing
coverage/
playwright-report/
test-results/

# env files: never commit secrets, but keep the example
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# PM2 (used later)
.pm2/

# deployment
.vercel

# certificates / keys
*.pem
*.key

# OS files
.DS_Store
Thumbs.db
desktop.ini

# editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Claude Code local settings
.claude/settings.local.json
